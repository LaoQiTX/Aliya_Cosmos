{
  "name": "web_aliya_cosmos",
  "version": "1.0.0",
  "description": "本项目是基于《彼方的她》游戏二创，截至目前暂未完成所有功能\r 有bug和建议欢迎反馈",
  "main": "main.js",
  "scripts": {
    "start": "set NODE_ENV=dev&& electron .",
    "build": "electron-builder --win --x64",
    "ele_pack": "set NODE_ENV=prod&& npx electron-packager . QDW_demo --platform=win32 --arch=x64 --out=dist --overwrite --icon=QDW.ico --asar",
    "vite_build":"npx vite build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "terser": "^5.39.0",
    "vite": "^6.3.5",
    "vite-plugin-obfuscator": "^1.0.5"
  },
  "build": {
    "asar": true,
    "appId": "com.qdw.yae",
    "productName": "QDW_demo",
    "win": {
      "target": "nsis",
      "icon": "./QDW.ico",
      "sign": false
    },
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      {
        "from": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@electron/asar": "^3.4.1",
    "original-fs": "^1.2.0"
  }
}
